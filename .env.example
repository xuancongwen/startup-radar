# Bearer tokens, one per client, as comma-separated label:secret pairs. The label appears in logs;
# the secret is what the client sends. Make a secret with: openssl rand -hex 32
RADAR_TOKENS=mondayflow-acme:change-me-to-a-long-random-secret

# Lowest score the API serves. Clients may ask for a higher floor, never a lower one.
RADAR_MIN_SCORE=10

# Pipeline intake. Start low and raise deliberately; every admitted domain is one homepage fetch.
RADAR_MAX_PER_MINUTE=20
RADAR_CONCURRENCY=10
RADAR_THRESHOLD=7
RADAR_USER_AGENT=StartupRadar/0.2 (research; contact: you@example.com)

# Where the API listens on the host. 127.0.0.1 with the TLS overlay for a public box;
# a LAN address (or 0.0.0.0 behind your own firewall) for a homelab host.
RADAR_BIND=127.0.0.1
RADAR_PORT=8081

# Host directory for the SQLite file and CSVs, and the uid/gid that owns it.
RADAR_DATA=./data
RADAR_UID=1000
RADAR_GID=1000

# TLS overlay only: the public name Caddy obtains a certificate for.
DOMAIN=radar.example.com
