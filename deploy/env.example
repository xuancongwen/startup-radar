# /etc/startup-radar/env  (mode 600, owned by root; read by the systemd units)
RADAR_TOKENS=mondayflow-acme:change-me-to-a-long-random-secret
RADAR_MIN_SCORE=10
RADAR_MAX_PER_MINUTE=20
RADAR_CONCURRENCY=10
RADAR_THRESHOLD=7
RADAR_USER_AGENT=StartupRadar/0.2 (research; contact: you@example.com)
# 127.0.0.1 behind a reverse proxy, or a LAN address on a homelab host you trust.
RADAR_BIND=127.0.0.1
RADAR_PORT=8081
